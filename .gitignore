# Библиотеки, которые npm скачивает сам — их не храним, они восстанавливаются командой npm install
node_modules/

# Собранная версия сайта — получается из исходников командой npm run build
dist/

# Локальные настройки и секреты — никогда не отправляем на GitHub
.env
.env.*
*.local

# Личные данные калькулятора (выгрузки «Скачать JSON» и папка для них) — только у себя на диске, не в git.
# Репозиторий публичный: сюда нельзя коммитить суммы, счета и сценарии.
ipoteka-*.json
private/
*.private.json
